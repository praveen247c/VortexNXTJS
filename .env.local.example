# --- Sanity (required to run the Studio + blog) ---
# After `npx sanity login` and creating a project, copy these from
# https://www.sanity.io/manage  ->  your project  ->  API.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# --- Migration only (not needed at runtime) ---
# Sanity Editor/write token: sanity.io/manage -> API -> Tokens (Editor role).
SANITY_API_WRITE_TOKEN=

# Webflow Data API v2 token + the site you are migrating from.
# Webflow -> Site settings -> Apps & integrations -> API access.
WEBFLOW_API_TOKEN=
WEBFLOW_SITE_ID=
